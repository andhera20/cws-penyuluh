rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == "admin"; }
    function myDistrict() { return signedIn() ? request.auth.token.district : null; }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // Role/claims hanya dapat diberikan melalui Admin SDK di Cloud Function.
      allow create, update, delete: if false;
    }

    match /employees/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.district == myDistrict();
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.district == myDistrict());
      allow delete: if isAdmin();
    }

    match /areas/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.district == myDistrict());
      allow write: if isAdmin();
    }

    match /reports/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.district == myDistrict();
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
